# MongoDB Connection Configuration
# In Netlify: Go to Site Settings > Environment Variables > Add Variable
# Key: MONGODB_URI
# Value: mongodb+srv://<username>:<password>@cluster0.mongodb.net/thatsmygurl?retryWrites=true&w=majority

MONGODB_URI=mongodb+srv://admin:password@cluster0.mongodb.net/thatsmygurl?retryWrites=true&w=majority

# Optional: Custom JWT or App Secret for sessions
APP_SECRET=thats-my-gurl-super-secret-key-2026

